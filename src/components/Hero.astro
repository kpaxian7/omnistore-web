---
import { t, type Locale } from '../i18n/ui';
import AppMock from './AppMock.astro';

interface Props { locale: Locale }
const { locale } = Astro.props;
const tr = t(locale);
const downloadMac = import.meta.env.PUBLIC_DOWNLOAD_MAC_URL ?? '#download';
---

<section class="relative overflow-hidden bg-gradient-to-b from-brand-paper to-white pt-20 sm:pt-24 lg:pt-28">
  <div aria-hidden="true" class="pointer-events-none absolute inset-x-0 -top-32 -z-0 mx-auto h-72 max-w-5xl rounded-full bg-[radial-gradient(closest-side,rgba(37,99,235,0.10),transparent)]"></div>

  <div class="container-page relative">
    <div class="mx-auto max-w-3xl text-center">
      <p class="eyebrow">{tr.hero.eyebrow}</p>
      <h1 class="h-display mt-3 whitespace-pre-line">{tr.hero.title}</h1>
      <p class="lede mx-auto mt-6 max-w-2xl">{tr.hero.subtitle}</p>

      <div class="mt-9 flex flex-wrap items-center justify-center gap-3">
        <a href={downloadMac} class="btn-primary" data-analytics="hero-download">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
          {tr.hero.primaryCta}
        </a>
        <a href="#features" class="btn-ghost" data-analytics="hero-see-features">
          {tr.hero.secondaryCta}
        </a>
      </div>

      <p class="mt-5 text-xs text-brand-mute">{tr.hero.platforms}</p>
    </div>

    <div class="relative mx-auto mt-16 max-w-5xl">
      <div class="rounded-2xl border border-brand-line bg-white p-2 shadow-card sm:p-3">
        <AppMock locale={locale} />
      </div>
      <div aria-hidden="true" class="pointer-events-none absolute -bottom-10 left-1/2 h-24 w-3/4 -translate-x-1/2 rounded-full bg-black/5 blur-3xl"></div>
    </div>
  </div>
</section>
